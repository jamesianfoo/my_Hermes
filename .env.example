# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port to listen on. Binds 0.0.0.0. Most PaaS hosts (Render, Railway, Heroku)
# set this for you — leave it unset there.
PORT=3000

# Public HTTPS base URL for this server, no trailing slash. Twilio fetches the
# TwiML and the ElevenLabs mp3s from here, so it must be reachable from the
# internet — use `ngrok http 3000` locally and paste the https URL it prints.
SERVER_URL=https://your-app.example.com

# IANA timezone name. Every time spoken to a caller and the Cal.com attendee
# timeZone use this. Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/New_York

# Business name the voice agent introduces itself with. Optional (defaults to
# "the home inspection team").
BUSINESS_NAME=Acme Home Inspections

# ---------------------------------------------------------------------------
# Claude — lead scoring
# ---------------------------------------------------------------------------

# Anthropic API key. console.anthropic.com -> Settings -> API keys.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for scoring. Optional (defaults to claude-sonnet-5).
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# ElevenLabs — text to speech
# ---------------------------------------------------------------------------

# ElevenLabs API key. elevenlabs.io -> your avatar (bottom left) -> API Keys.
ELEVEN_API_KEY=...

# Voice ID to speak with. elevenlabs.io -> Voices -> pick a voice -> the ID is
# in the URL and under the voice's "ID" button. Not the voice *name*.
ELEVEN_VOICE_ID=...

# How long to wait for synthesis before falling back to Twilio <Say>, in ms.
# Optional (defaults to 8000). Keep it well under Twilio's 15s webhook timeout.
ELEVEN_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Twilio — outbound calls and owner alerts
# ---------------------------------------------------------------------------

# Account SID and Auth Token, both on the Twilio Console dashboard home page.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...

# The Twilio number calls and texts come FROM, in E.164. Console -> Phone
# Numbers -> Manage -> Active numbers. Must be voice- and SMS-capable.
TWILIO_PHONE_NUMBER=+15550001111

# Business owner's mobile, in E.164. Gets a text whenever a Hot lead comes in.
OWNER_PHONE_NUMBER=+15550002222

# ---------------------------------------------------------------------------
# Cal.com — availability and booking
# ---------------------------------------------------------------------------

# Cal.com API key. cal.com -> Settings -> Developer -> API keys.
CAL_API_KEY=cal_live_...

# Your Cal.com username, i.e. the cal.com/<username> part of your booking link.
CAL_USERNAME=your-cal-username

# Numeric event type ID for the inspection. Open the event type in Cal.com and
# read the number from the URL: /event-types/123456. Digits only — the code
# sends this to Cal.com as a number, and a non-numeric value will 400.
CAL_EVENT_TYPE_ID=123456

# Event type slug, the cal.com/<username>/<slug> part. Optional — sent as an
# extra hint on the availability lookup.
CAL_EVENT_TYPE_SLUG=home-inspection

# ---------------------------------------------------------------------------
# Google Sheets — lead log
# ---------------------------------------------------------------------------

# Service account email, from the JSON key file's "client_email" field. Google
# Cloud Console -> IAM & Admin -> Service Accounts. You must share the target
# spreadsheet with this address as an Editor, or writes 403.
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com

# Private key from the same JSON key file's "private_key" field. Keep the
# surrounding quotes and the literal \n escapes exactly as they appear there.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Spreadsheet ID — the long token in the sheet URL between /d/ and /edit.
GOOGLE_SHEET_ID=...

# Tab name within that spreadsheet. Optional (defaults to "Leads"). The header
# row is written automatically on first use.
GOOGLE_SHEET_NAME=Leads

# ---------------------------------------------------------------------------
# Typeform — webhook authentication
# ---------------------------------------------------------------------------

# Shared secret used to verify the Typeform-Signature header on incoming
# submissions. You choose this value: Typeform -> your form -> Connect ->
# Webhooks -> your endpoint -> Secret. Paste the same string in both places.
# If left unset the signature check is skipped and ANY caller can post leads —
# set it before going live.
TYPEFORM_SECRET=...
